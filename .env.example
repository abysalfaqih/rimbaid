# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local. Hanya .env.example (tanpa nilai rahasia) yang masuk Git.

# URL situs TANPA slash di akhir.
# Lokal: http://localhost:3000
# Produksi: URL asli situs (https://...)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Koneksi database untuk aplikasi (rahasia!).
# Supabase: tombol "Connect" di proyek > "Transaction pooler" (port 6543).
# Format: postgresql://postgres.<ref-proyek>:<PASSWORD>@<host-pooler>:6543/postgres
# Lokal memakai proyek "dev"; di Vercel, Production memakai proyek "prod".
DATABASE_URL=


# Koneksi untuk MIGRASI database (rahasia!). Hanya dipakai skrip `pnpm db:migrate`, TIDAK dipakai aplikasi.
# Supabase: tombol "Connect" > "Session pooler" (port 5432, host *.pooler.supabase.com).
# Format: postgresql://postgres.<ref-proyek>:<PASSWORD>@<host-pooler>:5432/postgres
#
# Proyek DEV   -> isi di .env.local
# Proyek PROD  -> isi di berkas terpisah .env.migrate-prod.local (satu baris yang sama, URL proyek prod).
#                 Nama berkas itu sengaja tidak dikenali Next.js, jadi tidak ikut ter-build.
DATABASE_MIGRATION_URL=
