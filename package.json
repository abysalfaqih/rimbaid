{
  "name": "rimbaid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-messages.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:test": "node --test scripts/db-test.mjs",
    "db:migrate": "node scripts/db.mjs migrate dev",
    "db:migrate:prod": "node scripts/db.mjs migrate prod",
    "db:verify": "node scripts/db.mjs verify dev",
    "db:verify:prod": "node scripts/db.mjs verify prod",
    "clean": "node scripts/clean.mjs .next",
    "clean:types": "node scripts/clean.mjs .next/dev/types",
    "check": "pnpm clean:types && pnpm i18n:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm db:test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  }
}
